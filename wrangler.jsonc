/**
 * Cloudflare Worker configuration.
 * Static-assets-only Worker: `wrangler deploy` uploads the contents of ./dist.
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mazes",
  "compatibility_date": "2026-11-17",
  // Cloudflare manages the DNS record and TLS certificate for custom domains automatically,
  // as long as thudfactor.com is an active zone in this account.
  "routes": [{ "pattern": "mazes.thudfactor.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown paths, matching the previous Netlify redirect rules.
    "not_found_handling": "single-page-application"
  }
}
